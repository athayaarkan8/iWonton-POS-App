# Local development. Copy to .env; never commit real credentials.
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///wonton_pos.db
FLASK_ENV=development
DEBUG=false

# Optional: Neon DIRECT (non-pooled) URL, used for schema migrations and pg_dump.
# Do not use this as the Vercel request DATABASE_URL.
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
